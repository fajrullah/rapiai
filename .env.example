# --- AUTH SETTINGS ---
# HuggingFace Hub token (get from huggingface.co/settings/tokens)
# Optional: Only needed for private models or if you hit rate limits
HF_TOKEN=""

# --- EMBEDDING SETTINGS ---
# Embedding model from HuggingFace
EMBEDDING_MODEL="BAAI/bge-base-en-v1.5"

# --- CHROMADB SETTINGS ---
# ChromaDB persistent storage path and collection name
CHROMA_PATH="./chroma_db"
CHROMA_COLLECTION="documents"

# --- CHUNKING SETTINGS ---
# Settings for splitting text into smaller chunks
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- RETRIEVAL SETTINGS ---
# Default number of top results to retrieve
DEFAULT_TOP_K=4

# --- API SETTINGS ---
# Temporary folder for uploaded PDF files during ingestion
TMP_DIR="./tmp"
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx